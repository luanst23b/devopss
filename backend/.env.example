DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
# For hosted SQL Server, use DB_PORT (usually 1433) instead of DB_INSTANCE.
# DB_PORT=
DB_NAME=tech_store
DB_USER=techzone_app
DB_PASSWORD=generated-on-first-start
# Hosted SQL Server should use encryption and validate its certificate.
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
